---
interface Props {
  name: 'mail' | 'instagram' | 'shop' | 'arrow-right' | 'arrow-left' | 'close';
}
const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'shop' && (
    <>
      <path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9Z" />
      <path d="M9 10V7a3 3 0 0 1 6 0v3" />
    </>
  )}
  {name === 'arrow-right' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5m6-6-6 6 6 6" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
