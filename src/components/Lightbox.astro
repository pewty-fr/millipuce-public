---
import Icon from './Icon.astro';
---

<dialog class="lightbox" aria-label="Visionneuse d’images">
  <figure>
    <img alt="" />
  </figure>
  <button class="lb-btn lb-close" type="button" aria-label="Fermer"><Icon name="close" /></button>
  <button class="lb-btn lb-prev" type="button" aria-label="Image précédente"><Icon name="arrow-left" /></button>
  <button class="lb-btn lb-next" type="button" aria-label="Image suivante"><Icon name="arrow-right" /></button>
  <p class="lb-count" aria-live="polite"></p>
</dialog>

<script>
  const SIZES = '(min-width: 900px) 86vh, 96vw';
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dialog.querySelector('img')!;
  const count = dialog.querySelector<HTMLElement>('.lb-count')!;
  let items: HTMLAnchorElement[] = [];
  let index = 0;
  let token = 0;

  function show(i: number) {
    index = (i + items.length) % items.length;
    const a = items[index];
    const tileImg = a.querySelector('img')!;
    const current = ++token;
    // Show the (already loaded) grid image straight away, then swap in the large one.
    img.removeAttribute('srcset');
    img.src = tileImg.currentSrc || tileImg.src;
    img.width = Number(a.dataset.w);
    img.height = Number(a.dataset.h);
    img.alt = tileImg.alt;
    const hi = new Image();
    hi.sizes = SIZES;
    hi.srcset = a.dataset.srcset ?? '';
    hi.src = a.href;
    hi.decode()
      .then(() => {
        if (current !== token) return;
        img.sizes = SIZES;
        img.srcset = hi.srcset;
        img.src = hi.src;
      })
      .catch(() => {});
    count.textContent = `${index + 1} / ${items.length}`;
    dialog.classList.toggle('single', items.length < 2);
    // Warm up the neighbours.
    for (const n of [index + 1, index - 1]) {
      const b = items[(n + items.length) % items.length];
      const pre = new Image();
      pre.sizes = SIZES;
      pre.srcset = b.dataset.srcset ?? '';
    }
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    items = [...(a.closest('[data-gallery]') ?? document).querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
    show(items.indexOf(a));
    dialog.showModal();
  });

  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));

  // Click on the backdrop (outside the picture) closes.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as Element).tagName === 'FIGURE') dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(index + 1);
    else if (e.key === 'ArrowLeft') show(index - 1);
  });

  // Swipe on touch screens.
  let startX = 0;
  let startY = 0;
  dialog.addEventListener(
    'touchstart',
    (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    },
    { passive: true },
  );
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx) * 1.5) dialog.close();
  });

  dialog.addEventListener('close', () => {
    token++;
    img.removeAttribute('srcset');
    img.removeAttribute('src');
  });
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #261b17;
    color: #fff;
    overscroll-behavior: contain;
  }

  .lightbox::backdrop {
    background: rgb(36 25 21 / 0.6);
  }

  .lightbox[open] {
    animation: fade 0.2s ease;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  figure {
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
    padding: 64px 16px 88px;
  }

  img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.35);
    user-select: none;
    -webkit-user-drag: none;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lb-btn:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .lb-btn :global(svg) {
    width: 24px;
    height: 24px;
  }

  .lb-close {
    top: max(12px, env(safe-area-inset-top));
    right: 12px;
  }

  .lb-prev,
  .lb-next {
    bottom: calc(18px + env(safe-area-inset-bottom));
  }

  .lb-prev {
    left: 16px;
  }

  .lb-next {
    right: 16px;
  }

  .lb-count {
    position: absolute;
    left: 50%;
    bottom: calc(30px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .single .lb-prev,
  .single .lb-next,
  .single .lb-count {
    display: none;
  }

  @media (min-width: 900px) {
    figure {
      padding: 48px 96px;
    }

    .lb-prev,
    .lb-next {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
      width: 56px;
      height: 56px;
    }

    .lb-prev {
      left: 24px;
    }

    .lb-next {
      right: 24px;
    }

    .lb-close {
      top: 20px;
      right: 24px;
    }

    .lb-count {
      bottom: 18px;
    }
  }
</style>
