---
// Four-pointed star, like the ones scattered through the illustrations.
interface Props {
  class?: string;
  color?: string;
  size?: number;
}
const { class: className, color = 'var(--mustard)', size = 24 } = Astro.props;
---

<svg class:list={['sparkle', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <path fill={color} d="M12 0c.9 7.4 4.6 11.1 12 12-7.4.9-11.1 4.6-12 12-.9-7.4-4.6-11.1-12-12 7.4-.9 11.1-4.6 12-12Z" />
</svg>
