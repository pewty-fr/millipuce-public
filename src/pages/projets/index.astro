---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/content';
---

<Base title="Projets" description="Collaborations et collections illustrées par Camille Potevin (Millipuce) : packaging, papeterie et objets.">
  <section class="container">
    <header class="page-head">
      <p class="eyebrow">Collaborations & collections</p>
      <h1>Projets</h1>
      <p class="lede">Des illustrations qui prennent vie sur des emballages, de la vaisselle, des cartes et des motifs.</p>
    </header>
    <div class="projects">
      {projects.map((p) => <ProjectCard project={p} headingLevel="h2" />)}
    </div>
  </section>
</Base>

<style>
  .page-head {
    max-width: 720px;
    margin: 0 auto;
    padding-block: clamp(16px, 4vw, 40px) clamp(28px, 5vw, 48px);
    text-align: center;
  }

  h1 {
    margin-top: 10px;
    font-size: clamp(2.25rem, 1.4rem + 3.5vw, 3.75rem);
  }

  .lede {
    margin-top: 12px;
    color: var(--ink-soft);
    font-size: 1.125rem;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: clamp(16px, 3vw, 32px);
  }
</style>
