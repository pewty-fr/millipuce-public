---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Sparkle from '../components/Sparkle.astro';
import { about, contact } from '../lib/content';
import { full, thumb, placeholder } from '../lib/images';

const portrait = about.image && (await full(about.image));
const portraitColour = about.image && (await placeholder(about.image));
const lettering = about.lettering && (await thumb(about.lettering));
const techniques = ['Gouache', 'Aquarelle', 'Tablette graphique'];
---

<Base title="À propos" description={about.paragraphs[0]}>
  <article class="about container">
    <header class="head">
      <p class="eyebrow">À propos</p>
      <h1>
        {
          lettering ? (
            <img
              src={lettering.src}
              srcset={lettering.srcset}
              sizes="(min-width: 900px) 520px, 90vw"
              width={lettering.width}
              height={lettering.height}
              alt="Camille Potevin"
            />
          ) : (
            'Camille Potevin'
          )
        }
      </h1>
    </header>

    {
      portrait && (
        <figure class="frame" style={`--ph:${portraitColour}`}>
          <img
            src={portrait.src}
            srcset={portrait.srcset}
            sizes="(min-width: 900px) 440px, 86vw"
            width={portrait.width}
            height={portrait.height}
            alt="Illustration de Camille Potevin : une jeune fille dessine à son bureau"
          />
          <Sparkle class="s1" size={34} />
          <Sparkle class="s2" size={18} color="var(--terracotta)" />
        </figure>
      )
    }

    <div class="text">
      {about.paragraphs.map((p) => <p>{p}</p>)}

      <h2 class="eyebrow">Techniques</h2>
      <ul class="chips">
        {techniques.map((t) => <li>{t}</li>)}
      </ul>

      <div class="actions">
        {
          contact.email && (
            <a class="btn btn--primary" href={`mailto:${contact.email}`}>
              <Icon name="mail" /> Me contacter
            </a>
          )
        }
        <a class="btn" href="/">Voir les illustrations</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .about {
    display: grid;
    grid-template-areas: 'head' 'frame' 'text';
    gap: clamp(24px, 4vw, 40px);
    padding-top: clamp(8px, 3vw, 32px);
  }

  .head {
    grid-area: head;
    text-align: center;
  }

  h1 {
    margin-top: 12px;
  }

  h1 img {
    width: min(100%, 520px);
    margin-inline: auto;
  }

  .frame {
    grid-area: frame;
    position: relative;
    justify-self: center;
    width: min(86vw, 440px);
    margin: 0;
    padding: 12px 12px 40px;
    background: var(--card);
    border-radius: 6px;
    box-shadow: var(--shadow-lift);
    transform: rotate(-2deg);
  }

  /* washi tape */
  .frame::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 50%;
    width: 110px;
    height: 30px;
    background: rgb(227 168 58 / 0.55);
    transform: translateX(-50%) rotate(3deg);
    border-radius: 2px;
  }

  .frame img {
    width: 100%;
    border-radius: 3px;
    background: var(--ph);
  }

  :global(.frame .sparkle) {
    position: absolute;
  }

  :global(.frame .s1) {
    right: -18px;
    top: 18%;
  }

  :global(.frame .s2) {
    left: -12px;
    bottom: 22%;
  }

  .text {
    grid-area: text;
    max-width: 36rem;
    justify-self: center;
    font-size: 1.125rem;
  }

  .text > p + p {
    margin-top: 1em;
  }

  .text > p:first-child {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.4;
  }

  h2.eyebrow {
    margin: 32px 0 12px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips li {
    padding: 6px 16px;
    border-radius: 999px;
    background: var(--paper-deep);
    border: 1.5px solid var(--line);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
      grid-template-areas: 'frame head' 'frame text';
      grid-template-rows: auto 1fr;
      column-gap: clamp(48px, 7vw, 112px);
      align-items: start;
      max-width: 1120px;
    }

    .head {
      text-align: left;
    }

    h1 img {
      margin-inline: 0;
    }

    .frame {
      position: sticky;
      top: 32px;
      width: 100%;
      margin-top: 24px;
    }

    .text {
      justify-self: start;
    }
  }
</style>
